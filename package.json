{
  "name": "teamspend-cli",
  "version": "0.2.3",
  "description": "See what your team actually spends on AI coding tools across a migration, in one comparison. Cursor, Claude Code, GitHub Copilot, OpenCode, and Codex CLI.",
  "homepage": "https://github.com/RudrenduPaul/teamspend#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/teamspend.git"
  },
  "bugs": {
    "url": "https://github.com/RudrenduPaul/teamspend/issues"
  },
  "type": "module",
  "bin": {
    "teamspend": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit --strict",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "ai-coding-agents",
    "cost",
    "finops",
    "cursor",
    "claude-code",
    "github-copilot",
    "opencode",
    "codex",
    "cost-tracking",
    "spend-tracking"
  ],
  "license": "Apache-2.0",
  "author": "Rudrendu Paul",
  "contributors": [
    "Sourav Nandy"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
