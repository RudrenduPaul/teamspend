{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/teamspend",
  "description": "Compares AI coding tool spend before and after a migration via MCP tools.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/teamspend",
    "source": "github"
  },
  "version": "0.2.6",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "teamspend-cli",
      "version": "0.2.6",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "teamspend-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "teamspend-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
